{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.6-luna",
  "agent": {
    "build": {
      "model": "openai/gpt-5.6-sol",
      "permission": {
        "task": {
          "*": "deny",
          "explore": "allow",
          "general": "allow",
          "t800r-docs": "allow",
          "t800r-astra": "ask"
        }
      }
    },
    "plan": {
      "model": "openai/gpt-5.6-sol",
      "permission": {
        "task": {
          "*": "deny",
          "explore": "allow",
          "general": "allow",
          "t800r-docs": "allow",
          "t800r-astra": "ask"
        }
      }
    },
    "explore": {
      "model": "openai/gpt-5.6-luna"
    },
    "general": {
      "model": "openai/gpt-5.6-terra"
    }
  }
}
